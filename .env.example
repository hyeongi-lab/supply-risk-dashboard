# 이 파일은 양식입니다. 같은 폴더의 .env 파일에 실제 값을 넣으세요. (.env는 GitHub에 올라가지 않음)

# Claude API 키 (console.anthropic.com → API Keys) — sk-ant- 로 시작
ANTHROPIC_API_KEY=

# 알림을 보내는 Gmail 주소와 앱 비밀번호 (Gmail 일반 비밀번호 아님. 16자리, 띄어쓰기 없이)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# '경계' 이상일 때 메일 받을 사람 (여러 명은 쉼표로 구분)
ALERT_TO=
# '심각'일 때 추가로 받을 팀 전체 주소 (비워 두면 ALERT_TO에게만)
ALERT_TO_TEAM=

# 1이면 실제로 보내지 않고 '모의 발송'으로만 기록 (Gmail 연결 전)
MAIL_SIMULATE=1
